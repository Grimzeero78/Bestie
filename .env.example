# Bestie — LLM provider settings (server-side only, never exposed to the browser)
# Copy to .env for local development, or set these as Cloudflare secrets in production.
#
# ── Option A: Cloudflare Workers AI (recommended for this project) ──
# Get your account ID from the Cloudflare dashboard.
LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
LLM_API_KEY=YOUR_WORKERS_AI_API_TOKEN
LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ── Option B: any OpenAI-compatible provider (OpenAI, OpenRouter, Groq, etc.) ──
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
