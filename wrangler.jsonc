{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bestie",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers AI binding: the worker calls the model directly through this
  // binding — no API keys or secrets required at runtime.
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    // Workers AI model used through the AI binding (and the REST fallback).
    // Free plan = 10,000 Neurons/day shared by ALL models, so the model
    // decides how many messages a day Bestie can send:
    //   llama-3.1-8b-instruct-fp8-fast  ≈ 26 Neurons/message → ~380 msgs/day
    //   llama-3.3-70b-instruct-fp8-fast ≈ 163 Neurons/message → ~60 msgs/day
    // If the fast model hiccups, route.ts escalates to the 70B automatically.
    // Flip LLM_MODEL back to the 70B if you upgrade to Workers Paid.
    "LLM_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast"
  },
  // NOTE: No secrets are required for Workers AI. If you prefer another
  // OpenAI-compatible provider instead, set these with `wrangler secret put`:
  //   npx wrangler secret put LLM_BASE_URL
  //   npx wrangler secret put LLM_API_KEY
}
